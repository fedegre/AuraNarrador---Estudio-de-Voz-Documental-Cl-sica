# Motores de IA. Por defecto todo corre en tu PC, sin claves ni costo:
#   TTS_ENGINE=kokoro    voz con Kokoro (local)       | gemini = Gemini 3.8 Flash TTS (nube, de pago)
#   SCRIPT_ENGINE=ollama mejora de guion con Ollama   | gemini = Gemini 3.8 Flash (nube)
TTS_ENGINE="kokoro"
SCRIPT_ENGINE="ollama"

# Ollama (https://ollama.com). El modelo debe estar descargado: ollama pull qwen2.5:7b
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Kokoro: carpeta con kokoro-v1.0.onnx y voices-v1.0.bin (por defecto ./modelos/kokoro)
KOKORO_MODELS_DIR="./modelos/kokoro"
# Acento: latam (es-419) o es (España)
KOKORO_ACCENT="latam"
# Python con kokoro-onnx, soundfile y numpy instalados (por defecto python / python3)
# PYTHON_BIN="python"

# GEMINI_API_KEY: solo hace falta si TTS_ENGINE o SCRIPT_ENGINE valen "gemini".
GEMINI_API_KEY=""

PORT=3000
